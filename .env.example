# Where Lens serves from
PORT=3001
SOURCE_DIR=/path/to/source/assets/dir
CACHE_DIR=/path/to/image/cache/dir
REGEN_LOG=/path/to/regen/log.json

# Public base URL of this server. Lambda fetches originals back through it, so
# it has to be reachable from AWS.
ORIGIN_BASE_URL=https://lens.example.com

# Signs the short-lived URLs Lambda uses to pull source images. Any long random
# string: openssl rand -base64 48
RAW_SIGNING_KEY=

# From the deploy: infra/deploy.sh prints this as FunctionUrl.
LENS_LAMBDA_URL=

# Credentials for the lens-compressor-invoker IAM user the stack creates.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# How many images to compress at once. Each one fans out to a Lambda invocation
# per accepted format.
MAX_CONCURRENT_JOBS=4
